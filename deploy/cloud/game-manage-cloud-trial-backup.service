[Unit]
Description=Owner-only online backups for independent game-manage trial

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/game-manage-cloud-trial/operator/post24/run-nightly-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/game-manage-cloud-trial-backups
MemoryMax=192M
CPUQuota=25%
TasksMax=32
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
LogNamespace=game-manage-cloud
